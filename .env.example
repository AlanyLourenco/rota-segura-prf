# Provedor:modelo do LangChain init_chat_model.
# Padrão: Google Gemini Flash (plano gratuito do Google AI Studio). Confira o ID atual em
# https://ai.google.dev/gemini-api/docs/models  (ex.: gemini-3.6-flash, gemini-3.8-flash)
# A cota grátis do Gemini é ~20 REQUISIÇÕES/DIA POR MODELO (não por tokens). Liste vários modelos separados
# por vírgula: se um der 429, o próximo responde (cada um tem cota própria → mais relatórios por dia).
LLM_MODEL=google_genai:gemini-3.6-flash,google_genai:gemini-3.8-flash,google_genai:gemini-3.5-flash,google_genai:gemini-3.1-flash-lite
GOOGLE_API_KEY=

# Orquestrador: vazio = usa a mesma cadeia acima (agente escolhe as tools; ~3 requisições por relatório).
# "offline" = plano fixo de tools, só o redator usa LLM (1–3 requisições por relatório).
ORCHESTRATOR_MODEL=

# Alternativas: anthropic:claude-sonnet-5-5 (ANTHROPIC_API_KEY) | groq:openai/gpt-oss-120b (GROQ_API_KEY)

# Opcional: busca de notícias via Tavily (sem chave usa RSS públicos)
TAVILY_API_KEY=
